# Application
APP_NAME=My FastAPI App
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Server
HOST=127.0.0.1
PORT=3001

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/v1/auth/google/callback
AUTH_SUCCESS_REDIRECT_URI=/api/v1/auth/me

# Authentication and sessions
JWT_SECRET_KEY=replace-with-a-random-value-at-least-32-characters
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=30

# Authentication cookies
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token

# File storage
UPLOAD_DIR=data/uploads

# CORS and rate limiting
CORS_ALLOWED_ORIGINS=
AUTH_RATE_LIMIT_PER_MINUTE=60
